	<queryString language="SQL">
		<![CDATA[SELECT
     data_pengurus.`id_pengurus` AS data_pengurus_id_pengurus,
     data_pengurus.`nama_pengurus` AS data_pengurus_nama_pengurus,
     data_pengurus.`jenis_kelamin` AS data_pengurus_jenis_kelamin,
     data_pengurus.`no_hp` AS data_pengurus_no_hp,
     data_pengurus.`alamat` AS data_pengurus_alamat,
     data_pengurus.`jabatan` AS data_pengurus_jabatan,
     data_pengurus.`wilayah_rt` AS data_pengurus_wilayah_rt,
     data_pengurus.`wilayah_rw` AS data_pengurus_wilayah_rw,
     data_pengurus.`mulai_menjabat` AS data_pengurus_mulai_menjabat,
     data_pengurus.`selesai_menjabat` AS data_pengurus_selesai_menjabat
FROM
     `data_pengurus` data_pengurus]]>
	</queryString>
