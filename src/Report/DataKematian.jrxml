	<queryString language="SQL">
		<![CDATA[SELECT
     data_kematian.`id_kematian` AS data_kematian_id_kematian,
     data_kematian.`nik` AS data_kematian_nik,
     data_kematian.`nama_penduduk` AS data_kematian_nama_penduduk,
     data_kematian.`id_fas` AS data_kematian_id_fas,
     data_kematian.`nama_fas` AS data_kematian_nama_fas,
     data_kematian.`tanggal_meninggal` AS data_kematian_tanggal_meninggal,
     data_kematian.`waktu_meninggal` AS data_kematian_waktu_meninggal,
     data_kematian.`lokasi_pemakaman` AS data_kematian_lokasi_pemakaman,
     data_kematian.`keterangan` AS data_kematian_keterangan
FROM
     `data_kematian` data_kematian]]>
	</queryString>
