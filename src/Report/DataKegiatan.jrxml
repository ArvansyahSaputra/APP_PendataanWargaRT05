	<queryString language="SQL">
		<![CDATA[SELECT
     data_kegiatan.`id_kegiatan` AS data_kegiatan_id_kegiatan,
     data_kegiatan.`id_pengurus` AS data_kegiatan_id_pengurus,
     data_kegiatan.`nama_pengurus` AS data_kegiatan_nama_pengurus,
     data_kegiatan.`id_fas` AS data_kegiatan_id_fas,
     data_kegiatan.`nama_fas` AS data_kegiatan_nama_fas,
     data_kegiatan.`nama_kegiatan` AS data_kegiatan_nama_kegiatan,
     data_kegiatan.`jenis_kegiatan` AS data_kegiatan_jenis_kegiatan,
     data_kegiatan.`tanggal_kegiatan` AS data_kegiatan_tanggal_kegiatan,
     data_kegiatan.`jam` AS data_kegiatan_jam,
     data_kegiatan.`jumlah_peserta` AS data_kegiatan_jumlah_peserta,
     data_kegiatan.`status_k` AS data_kegiatan_status_k,
     data_kegiatan.`Keterangan` AS data_kegiatan_Keterangan
FROM
     `data_kegiatan` data_kegiatan]]>
	</queryString>
